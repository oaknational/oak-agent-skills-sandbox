{
  "name": "oak-agent-skills-sandbox",
  "private": true,
  "description": "Rehearsal workspace for oak-agent-skills workflows.",
  "type": "module",
  "packageManager": "pnpm@11.28.7",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": ">=11"
  },
  "scripts": {
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "pnpm -r --if-present run lint",
    "test": "node --test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@oaknational/oak-agent-skills": "0.1.0",
    "example": "workspace:*",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "prettier": "3.10.1",
    "turbo": "2.11.13"
  },
  "oakSkills": {
    "profiles": [
      "base",
      "frontend"
    ],
    "include": [],
    "exclude": []
  }
}
